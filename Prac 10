import java.sql.*;

public class StudentCRUD {
    static final String URL = "jdbc:mysql://localhost:3306/college";
    static final String USER = "root";
    static final String PASSWORD = "root";

    public static void main(String[] args) {
        try (Connection con = DriverManager.getConnection(URL, USER, PASSWORD)) {
            con.setAutoCommit(false);

            // CREATE: insert a student record
            String insert = "INSERT INTO student VALUES (?, ?, ?, ?)";
            try (PreparedStatement ps = con.prepareStatement(insert)) {
                ps.setInt(1, 101);
                ps.setString(2, "Aarav");
                ps.setString(3, "AI&DS");
                ps.setDouble(4, 88.5);
                ps.executeUpdate();
            }
            con.commit();
            System.out.println("Student inserted successfully.");

            // READ: display all student records
            String select = "SELECT * FROM student";
            try (PreparedStatement ps = con.prepareStatement(select);
                 ResultSet rs = ps.executeQuery()) {
                System.out.println("\nID  Name  Course  Marks");
                while (rs.next()) {
                    System.out.println(rs.getInt("id") + "  " +
                            rs.getString("name") + "  " +
                            rs.getString("course") + "  " +
                            rs.getDouble("marks"));
                }
            }

            // UPDATE: change marks of a student
            String update = "UPDATE student SET marks=? WHERE id=?";
            try (PreparedStatement ps = con.prepareStatement(update)) {
                ps.setDouble(1, 92.0);
                ps.setInt(2, 101);
                ps.executeUpdate();
            }
            con.commit();
            System.out.println("\nStudent updated successfully.");

            // DELETE: remove a student record
            String delete = "DELETE FROM student WHERE id=?";
            try (PreparedStatement ps = con.prepareStatement(delete)) {
                ps.setInt(1, 101);
                ps.executeUpdate();
            }
            con.commit();
            System.out.println("Student deleted successfully.");

        } catch (SQLException e) {
            System.out.println("Database error: " + e.getMessage());
        }
    }
}
